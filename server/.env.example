# PostgreSQL Database URL from Neon (https://neon.tech)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Gemini API Key (used via OpenAI SDK endpoint)
GEMINI_API_KEY=your_gemini_api_key_here

# Clipdrop API Key (for text-to-image)
CLIPDROP_API_KEY=your_clipdrop_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Port (Optional, default is 3000)
PORT=5000
