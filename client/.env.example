# ==============================================================================
# QUICK AI - FRONTEND ENVIRONMENT VARIABLES (VITE)
# Add these variables to your Hosting Dashboard (Vercel, Netlify, Render, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & CORE SERVICES (REQUIRED)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Get from https://dashboard.clerk.com -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API Endpoint Base URL (e.g., https://your-backend-domain.com)
VITE_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY PUBLIC KEYS (OPTIONAL / DEFENSIVE)
# Defensive fallback handles missing keys cleanly without app crash/blank screen
# ------------------------------------------------------------------------------
# Stripe Publishable Key (Get from https://dashboard.stripe.com -> API Keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay Key ID (Get from https://dashboard.razorpay.com -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_...

# PayPal Client ID (Get from https://developer.paypal.com -> Apps & Credentials)
VITE_PAYPAL_CLIENT_ID=sb_client_id_...

# Lemon Squeezy Store ID (Get from https://app.lemonsqueezy.com -> Settings -> Stores)
VITE_LEMON_SQUEEZY_STORE_ID=12345
